{
  "name": "tg-cnc-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply tg-cnc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tg-cnc-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply tg-cnc-db-staging --env staging --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
