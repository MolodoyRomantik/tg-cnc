{
  "name": "tg-cnc-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute tg-cnc-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute tg-cnc-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.7.2",
    "wrangler": "^4.4.0"
  }
}
